{
  "contractVersion": "1.0",
  "repository": "sankarshanmukhopadhyay/trqp-assurance-hub",
  "release": "1.12.0",
  "role": "assurance-aggregator",
  "authority": {
    "semanticAuthority": {"repository": "sankarshanmukhopadhyay/trust-systems-meta-model", "version": "0.24.0", "artifacts": ["bindings/trqp/tsmm-trqp-binding.json","model/semantic-concepts.json","schemas/semantic-projection.schema.json"]},
    "schemaAuthority": {"repository": "sankarshanmukhopadhyay/trust-infrastructure-schemas", "version": "0.15.0", "artifacts": ["portfolio/portfolio-relationship.schema.json","portfolio/repository-authority.schema.json","portfolio/portfolio-validation-result.schema.json","assurance/assurance-lifecycle-event.schema.json"]}
  },
  "provides": ["combined assurance decisions","cross-repository assurance manifests","assurance traceability evidence","CTS evidence reproducibility status","current-assurance lifecycle recomposition and supersession lineage"],
  "consumes": ["TRQP-TSPP protocol validation evidence","TRQP Conformance Suite execution evidence","TRQP Conformance Suite replay determinism evidence","TSMM semantic bindings and TIS portfolio/lifecycle contracts"],
  "evidence": [
