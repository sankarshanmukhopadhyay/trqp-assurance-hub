  "relationships": [
    {"repository": "sankarshanmukhopadhyay/TRQP-TSPP", "relation": "assures"},
    {"repository": "sankarshanmukhopadhyay/trqp-conformance-suite", "relation": "aggregates-evidence-from"}
  ],
  "revocation": {"triggers": ["semantic-authority-version-incompatible","schema-authority-version-incompatible","required-evidence-missing","source-assurance-evidence-invalid","source-replay-determinism-invalid","source-replay-policy-incompatible"], "effect": "integration-status-invalid"}
