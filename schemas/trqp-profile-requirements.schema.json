{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/trqp-assurance-hub/schemas/trqp-profile-requirements.schema.json",
  "title": "TRQP Profile Requirement Catalogue",
  "type": "object",
  "required": ["profile_id", "profile_version", "source", "requirements"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["repository", "revision", "document"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 7},
        "document": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "strength", "scope", "statement", "source_anchor", "testability"],
        "properties": {
          "id": {"type": "string", "pattern": "^AYRA-[A-Z]+-[0-9]{3}$"},
          "strength": {"enum": ["MUST", "MUST_NOT", "SHOULD", "SHOULD_NOT", "MAY"]},
          "scope": {"enum": ["core_profile", "extension", "operational", "authority", "security"]},
          "statement": {"type": "string", "minLength": 1},
          "source_anchor": {"type": "string", "minLength": 1},
          "applicability": {"type": "string"},
          "testability": {"enum": ["testable", "observable", "requires_external_evidence", "currently_indeterminate"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
